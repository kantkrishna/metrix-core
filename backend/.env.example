# .env.example
#
# Purpose: Documents all required environment variables for local development, migrations, OIDC, Redis, and observability.
#
# Context: Separates DATABASE_ADMIN_URL (metrix_owner DDL role) from DATABASE_URL (metrix_app NOBYPASSRLS runtime role) to guarantee RLS enforcement.
#
# Implementation Specs: dotenv key-value template covering NestJS port/prefix, PostgreSQL 16 dual roles, OIDC JWKS, Redis/BullMQ, 32-byte KMS hex key, and OTLP.

NODE_ENV=development
PORT=4001
API_PREFIX=api/v1/core
CORS_ORIGIN=http://localhost:3000

# 1. Schema owner role — used ONLY by drizzle-kit push & SQL RLS migrations
DATABASE_ADMIN_URL=postgresql://metrix_owner:metrix_owner_dev_pwd@localhost:5432/metrix_platform_core

# 2. Runtime application role — NON-SUPERUSER, NOBYPASSRLS
DATABASE_URL=postgresql://metrix_app:metrix_app_dev_pwd@localhost:5432/metrix_platform_core
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# Delegated Managed OIDC / OAuth 2.0 Provider (No local password storage)
OIDC_ISSUER_URL=https://id.metrix-erp.cloud/realms/platform-core
OIDC_CLIENT_ID=metrix-platform-core-web
OIDC_CLIENT_SECRET=replace_with_oidc_client_secret
OIDC_JWKS_URI=https://id.metrix-erp.cloud/realms/platform-core/protocol/openid-connect/certs
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Redis & BullMQ (App Shell Manifest Cache & Async Notification Orchestration)
REDIS_URL=redis://localhost:6379/0
BULLMQ_PREFIX=metrix:core

# Encryption Key (32-byte hex for webhook HMAC secret envelope encryption)
KMS_ENVELOPE_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OpenTelemetry Observability
OTEL_SERVICE_NAME=metrix-platform-core-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
