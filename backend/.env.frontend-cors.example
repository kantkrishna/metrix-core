# .env.frontend-cors.example
#
# Purpose: Documents CORS allowlist and OIDC callback origins required by the
# METRix Platform Core Next.js frontend during Epic 1 local development.
#
# Context: Reference env snippet for metrix-core/backend/.env.
#
# Implementation Specs: Ensure NestJS enableCors() permits Authorization,
# X-Tenant-Id, X-Organization-Id, and Accept-Language from localhost:3000.

CORS_ALLOWED_ORIGINS="http://localhost:3000"
CORS_ALLOWED_HEADERS="Authorization,Content-Type,X-Tenant-Id,X-Organization-Id,Accept-Language"
FRONTEND_ORIGIN="http://localhost:3000"
OIDC_FRONTEND_CALLBACK_URL="http://localhost:3000/auth/callback"
OIDC_DEV_MOCK_ENABLED="true"
