# frontend/.env.example
#
# Purpose: Documents required public and server runtime environment variables
# for the METRix Platform Core Next.js frontend.
#
# Context: Aligns frontend API routing with the Platform Core OpenAPI 3.1
# servers and managed OIDC/OAuth 2.0 PKCE configuration.
#
# Implementation Specs: Validated at startup by src/config/env.ts using Zod v4.

NEXT_PUBLIC_APP_NAME="METRix Platform Core"
NEXT_PUBLIC_PLATFORM_CORE_API_URL="http://localhost:4001/api/v1/core"
NEXT_PUBLIC_APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en-IN"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_DEFAULT_CURRENCY="INR"
NEXT_PUBLIC_ENABLE_MULTI_LANGUAGE="false"
