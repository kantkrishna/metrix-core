# ==============================================================================
# METRix Core — Repository Root .gitignore (Phase 0 Baseline)
# Preserves subproject-specific rules in backend/.gitignore & frontend/.gitignore
# ==============================================================================

# Dependencies
node_modules/

# Environment & local secrets (keep all *.example templates tracked)
.env
.env.*
!.env.example
!.env.*.example

# Build, cache & compiler outputs
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# Test & coverage artifacts
coverage/
playwright-report/
test-results/
blob-report/

# Logs & runtime diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor artifacts
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json