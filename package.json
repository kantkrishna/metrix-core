{
  "name": "metrix-core",
  "version": "0.1.0",
  "private": true,
  "description": "METRix Platform Core unified root task orchestrator (lightweight polyrepo)",
  "engines": {
    "node": ">=20",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "install:backend": "pnpm --dir backend install",
    "install:frontend": "pnpm --dir frontend install",
    "install:all": "pnpm install && pnpm run install:backend && pnpm run install:frontend",
    "ci:backend": "pnpm --dir backend install --frozen-lockfile",
    "ci:frontend": "pnpm --dir frontend install --frozen-lockfile",
    "ci:all": "pnpm install --frozen-lockfile && pnpm run ci:backend && pnpm run ci:frontend",
    "dev:backend": "pnpm --dir backend run start:dev",
    "dev:frontend": "pnpm --dir frontend run dev",
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "build:backend": "pnpm --dir backend run build",
    "build:frontend": "pnpm --dir frontend run build",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "start:backend": "pnpm --dir backend run start:prod",
    "start:frontend": "pnpm --dir frontend run start",
    "start": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"pnpm run start:backend\" \"pnpm run start:frontend\"",
    "lint:frontend": "pnpm --dir frontend run lint",
    "typecheck:backend": "pnpm --dir backend run typecheck",
    "typecheck:frontend": "pnpm --dir frontend run typecheck",
    "typecheck": "pnpm run typecheck:backend && pnpm run typecheck:frontend",
    "openapi:validate": "pnpm --dir backend run openapi:validate",
    "test:backend": "pnpm --dir backend run test:unit",
    "test:backend:integration": "pnpm --dir backend run test:integration",
    "test:frontend": "pnpm --dir frontend run test:unit",
    "test:frontend:coverage": "pnpm --dir frontend run test:coverage",
    "test:bdd": "pnpm --dir frontend run test:bdd",
    "test:e2e": "pnpm --dir frontend run test:e2e",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "verify:backend": "pnpm --dir backend run verify:all",
    "verify:frontend": "pnpm --dir frontend run verify:all",
    "verify:all": "pnpm run verify:backend && pnpm run verify:frontend && pnpm run test:bdd",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose --profile bootstrap down",
    "docker:config": "docker compose config --services",
    "docker:build": "docker compose --profile bootstrap build",
    "docker:up": "docker compose up -d",
    "docker:up:build": "docker compose up -d --build",
    "docker:up:bootstrap": "docker compose --profile bootstrap up -d",
    "docker:up:bootstrap:build": "docker compose --profile bootstrap up -d --build",
    "docker:bootstrap": "docker compose --profile bootstrap run --rm db-bootstrap",
    "docker:infra": "docker compose up -d postgres redis",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose --profile bootstrap down",
    "docker:reset": "docker compose --profile bootstrap down -v && pnpm run docker:up:bootstrap",
    "db:generate": "pnpm --dir backend run db:generate",
    "db:push": "pnpm --dir backend run db:push",
    "db:migrate:rls": "pnpm --dir backend run db:migrate:rls",
    "db:seed": "pnpm --dir backend run db:seed",
    "db:bootstrap": "pnpm --dir backend run db:bootstrap",
    "db:studio": "pnpm --dir backend run db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
